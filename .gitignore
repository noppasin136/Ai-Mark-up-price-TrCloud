# Data — never commit ERP extracts or priced output
data/input/*
data/output/*
!data/input/.gitkeep
!data/output/.gitkeep
!data/input/samples/
*.xlsx
*.xls
*.xlsb
*.tgz
_verify*

# config/unit_review.xlsx holds your unit decisions — the record of WHY a price
# is what it is. It is excluded above because it also carries costs and selling
# prices, which do not belong in a public repository. If this repo is private,
# uncomment the next line to version the decisions with the code:
!config/unit_review.xlsx
*.csv
!tests/fixtures/*.csv

# Python
__pycache__/
*.py[cod]
.venv/
venv/
env/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Editors / OS
# The VS Code workspace config IS part of the project — it is what gives the
# next person the tasks, debug entries and interpreter settings. Only the
# machine-specific bits are excluded.
.vscode/*
!.vscode/settings.json
!.vscode/launch.json
!.vscode/tasks.json
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
~$*
