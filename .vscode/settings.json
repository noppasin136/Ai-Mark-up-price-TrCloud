{
  // Use the project's own virtual environment, not whatever Python is on PATH.
  "python.defaultInterpreterPath": "${workspaceFolder}/.venv/Scripts/python.exe",
  "python.terminal.activateEnvironment": true,

  // The package lives under src/, so Pylance needs to be told where to look.
  // This is what makes "go to definition" and autocomplete work on `markup.*`.
  "python.analysis.extraPaths": ["${workspaceFolder}/src"],
  "python.analysis.autoImportCompletions": true,
  "python.analysis.typeCheckingMode": "basic",

  // Lets `python -m markup ...` work in a plain terminal even before
  // `pip install -e .` has been run.
  "terminal.integrated.env.windows": {
    "PYTHONPATH": "${workspaceFolder}\\src"
  },

  "python.testing.pytestEnabled": true,
  "python.testing.unittestEnabled": false,
  "python.testing.pytestArgs": ["tests"],

  "[python]": {
    "editor.defaultFormatter": "charliermarsh.ruff",
    "editor.formatOnSave": false,
    "editor.rulers": [100],
    "editor.codeActionsOnSave": {
      "source.organizeImports": "explicit"
    }
  },
  "[yaml]": {
    "editor.tabSize": 2,
    "editor.insertSpaces": true
  },

  // config.yaml is the file you will edit most — keep comments readable.
  "yaml.format.enable": true,
  "files.trimTrailingWhitespace": true,
  "files.insertFinalNewline": true,

  "files.exclude": {
    "**/__pycache__": true,
    "**/*.egg-info": true,
    "**/.pytest_cache": true,
    "**/.ruff_cache": true
  },
  "search.exclude": {
    "**/.venv": true,
    "**/data/output": true,
    "**/data/input": true
  },

  // The ERP exports are large; watching them slows the editor down for nothing.
  "files.watcherExclude": {
    "**/.venv/**": true,
    "**/data/input/**": true,
    "**/data/output/**": true
  }
}
